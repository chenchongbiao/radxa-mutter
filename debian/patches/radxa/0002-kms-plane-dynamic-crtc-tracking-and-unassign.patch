From: Chongbiao Chen <chenchongbiao@radxa.com>
Date: Thu, 12 Jun 2026 10:30:00 +0800
Subject: kms/plane: Dynamic CRTC tracking + unassign planes on CRTC disable

The upstream fix (MR !4850) reads current_crtc_id from DRM at init
time but never updates it.  On Qualcomm platforms this causes stale
CRTC tracking after mode switches and hotplug events, leading to:

  - DP+HDMI dual display: unplugging primary DP causes dock
    disappearance and mouse freeze on the remaining HDMI display
  - drmModeAtomicCommit EINVAL when toggling mirror/extend modes
  - Dual Type-C hot-unplug leaves remaining display blue on Q8B

Track plane-to-CRTC assignment dynamically in set_config,
assign_planes so that find_unassigned_plane() always sees the
correct CRTC binding.  Add a setter for current_crtc_id and
initialize it for fake planes.

When a CRTC is disabled in set_mode(), explicitly unassign its
primary and cursor planes in the same KMS update that unsets the
mode, preventing the kernel from scanning out stale framebuffers
on a disabled CRTC.

Bug: https://gitlab.gnome.org/GNOME/mutter/-/issues/4399
Bug-Radxa: DP+HDMI+Dual-Type-C hot-unplug freeze/blue-screen on Q8B (SC8280XP)
Forwarded: not-needed
Last-Update: 2026-06-18
Applied-Upstream: not-yet
---
diff --git a/src/backends/native/meta-crtc-kms.c b/src/backends/native/meta-crtc-kms.c
index 838964b54..2973080c5 100644
--- a/src/backends/native/meta-crtc-kms.c
+++ b/src/backends/native/meta-crtc-kms.c
@@ -335,7 +335,6 @@ find_unassigned_plane (MetaCrtcKms      *crtc_kms,
 {
   MetaKmsCrtc *kms_crtc = meta_crtc_kms_get_kms_crtc (crtc_kms);
   MetaKmsDevice *kms_device = meta_kms_crtc_get_device (kms_crtc);
-  uint32_t target_crtc_id = meta_kms_crtc_get_id (kms_crtc);
   MetaKmsPlane *assigned_plane = crtc_assigned_plane (crtc_kms, kms_plane_type);
   GList *l;
 
@@ -351,6 +350,7 @@ find_unassigned_plane (MetaCrtcKms      *crtc_kms,
   for (l = meta_kms_device_get_planes (kms_device); l; l = l->next)
     {
       MetaKmsPlane *kms_plane = l->data;
+      uint32_t target_crtc_id = meta_kms_crtc_get_id (kms_crtc);
 
       if (meta_kms_plane_get_plane_type (kms_plane) != kms_plane_type)
         continue;
@@ -438,6 +438,16 @@ meta_crtc_kms_set_config (MetaCrtc             *crtc,
 
   crtc_kms->assigned_primary_plane = kms_assignment->primary_plane;
   crtc_kms->assigned_cursor_plane = kms_assignment->cursor_plane;
+
+  MetaKmsCrtc *kms_crtc = meta_crtc_kms_get_kms_crtc (crtc_kms);
+  uint32_t crtc_id = meta_kms_crtc_get_id (kms_crtc);
+
+  if (kms_assignment->primary_plane)
+    meta_kms_plane_set_current_crtc_id (kms_assignment->primary_plane,
+                                        crtc_id);
+  if (kms_assignment->cursor_plane)
+    meta_kms_plane_set_current_crtc_id (kms_assignment->cursor_plane,
+                                        crtc_id);
 }
 
 void
@@ -445,8 +455,17 @@ meta_crtc_kms_assign_planes (MetaCrtcKms  *crtc_kms,
                              MetaKmsPlane *primary_plane,
                              MetaKmsPlane *cursor_plane)
 {
+
+  MetaKmsCrtc *kms_crtc = meta_crtc_kms_get_kms_crtc (crtc_kms);
+  uint32_t crtc_id = meta_kms_crtc_get_id (kms_crtc);
+
   crtc_kms->assigned_primary_plane = primary_plane;
   crtc_kms->assigned_cursor_plane = cursor_plane;
+
+  if (primary_plane)
+    meta_kms_plane_set_current_crtc_id (primary_plane, crtc_id);
+  if (cursor_plane)
+    meta_kms_plane_set_current_crtc_id (cursor_plane, crtc_id);
 }
 
 static void
@@ -553,6 +572,26 @@ meta_crtc_kms_set_mode (MetaCrtcKms   *crtc_kms,
     }
   else
     {
+
+      MetaKmsCrtc *kms_crtc = meta_crtc_kms_get_kms_crtc (crtc_kms);
+
+      if (crtc_kms->assigned_primary_plane)
+        {
+          meta_kms_update_unassign_plane (kms_update,
+                                          kms_crtc,
+                                          crtc_kms->assigned_primary_plane);
+          meta_kms_plane_set_current_crtc_id (crtc_kms->assigned_primary_plane, 0);
+          crtc_kms->assigned_primary_plane = NULL;
+        }
+      if (crtc_kms->assigned_cursor_plane)
+        {
+          meta_kms_update_unassign_plane (kms_update,
+                                          kms_crtc,
+                                          crtc_kms->assigned_cursor_plane);
+          meta_kms_plane_set_current_crtc_id (crtc_kms->assigned_cursor_plane, 0);
+          crtc_kms->assigned_cursor_plane = NULL;
+        }
+
       kms_mode = NULL;
 
       meta_topic (META_DEBUG_KMS,
diff --git a/src/backends/native/meta-kms-plane-private.h b/src/backends/native/meta-kms-plane-private.h
index 18885fd67..2c9ff7332 100644
--- a/src/backends/native/meta-kms-plane-private.h
+++ b/src/backends/native/meta-kms-plane-private.h
@@ -92,3 +92,6 @@ MetaKmsPropType meta_kms_plane_get_prop_internal_type (MetaKmsPlane     *plane,
                                                        MetaKmsPlaneProp  prop);
 
 uint32_t meta_kms_plane_get_current_crtc_id (MetaKmsPlane *plane);
+
+void meta_kms_plane_set_current_crtc_id (MetaKmsPlane *plane,
+                                         uint32_t      crtc_id);
diff --git a/src/backends/native/meta-kms-plane.c b/src/backends/native/meta-kms-plane.c
index a0e89c5e7..f4e359779 100644
--- a/src/backends/native/meta-kms-plane.c
+++ b/src/backends/native/meta-kms-plane.c
@@ -104,6 +104,13 @@ meta_kms_plane_get_current_crtc_id (MetaKmsPlane *plane)
   return plane->current_crtc_id;
 }
 
+void
+meta_kms_plane_set_current_crtc_id (MetaKmsPlane *plane,
+                                    uint32_t      crtc_id)
+{
